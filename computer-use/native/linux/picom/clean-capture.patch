+
+xcb_pixmap_t paint_clean_crop(session_t *ps, struct managed_win *bottom,
+                                      int16_t x, int16_t y, uint16_t width, uint16_t height) {
+	paint_t normal = ps->tgt_buffer;
+	paint_t clean = {0};
+	clean.pixmap = x_create_pixmap(ps->c, (uint8_t)ps->depth, ps->root,
+	                              ps->root_width, ps->root_height);
+	if (!clean.pixmap)
+		return 0;
+	clean.pict = x_create_picture_with_visual_and_pixmap(ps->c, ps->vis, clean.pixmap, 0, 0);
+	if (!clean.pict) {
+		free_paint(ps, &clean);
+		return 0;
+	}
+
+	region_t region;
+	pixman_region32_init_rect(&region, x, y, width, height);
+	// Background blur can sample pixels outside the requested crop.
+	if (ps->o.blur_method != BLUR_METHOD_NONE)
+		pixman_region32_copy(&region, &ps->screen_reg);
+	ps->tgt_buffer = clean;
+	paint_all_impl(ps, bottom, false, &region);
+	ps->tgt_buffer = normal;
+	pixman_region32_fini(&region);
+
+	free_picture(ps->c, &clean.pict);
+	return clean.pixmap;
+}
